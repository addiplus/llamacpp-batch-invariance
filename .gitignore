# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------------------------------------------------------------------------
# Packaging / build artifacts
# ---------------------------------------------------------------------------
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.verifyvenv/
.python-version

# ---------------------------------------------------------------------------
# Per-operator profile model registry. The committed file is models.example.toml;
# an operator copies it to models.toml and fills in THEIR real gguf paths + server
# binary -- that copy is host-specific and must never be committed.
# ---------------------------------------------------------------------------
src/batch_invariance/profiles/*/models.toml
profiles/*/models.toml

# ---------------------------------------------------------------------------
# Test / lint / type caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Generated certs (a run writes certs/<model>__ctx<C>__N<N>.json here).
# Anchored to the top-level certs/ dir only so the ONE bundled proof cert
# committed explicitly under examples/certs/ is NOT swept up.
# ---------------------------------------------------------------------------
/certs/*.json
!examples/certs/*.json

# ---------------------------------------------------------------------------
# Internal build/scrub scaffolding -- NOT part of the public release.
# These document the pre-scrub provenance + verification of this package and
# are intentionally kept out of the public repo (and out of the sdist include
# list). They are local-only working notes.
# ---------------------------------------------------------------------------
_PLAN/
_VERIFY.json

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
